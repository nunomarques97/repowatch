{
  "name": "repowatch",
  "private": true,
  "version": "0.1.0",
  "description": "A light desktop app that shows the git state of every repository on your machine, and works as a git GUI.",
  "license": "MIT",
  "author": "Nuno Marques",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/msvc-env.mjs tauri",
    "lint": "eslint . --max-warnings 0",
    "lint:rust": "cargo fmt --all -- --check && node scripts/msvc-env.mjs cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:ui": "node scripts/ui-check.mjs",
    "e2e": "node scripts/e2e.mjs",
    "build:installer": "node scripts/msvc-env.mjs tauri build --bundles nsis --ci",
    "verify:installer": "node scripts/verify-installer.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:check": "node scripts/bench.mjs --check",
    "test:rust": "node scripts/msvc-env.mjs cargo test --workspace --locked",
    "check": "npm run lint && npm run lint:rust && npm run typecheck && npm test && npm run test:rust && npm run verify:docs",
    "design:check": "node scripts/design-check.mjs",
    "design:screenshots": "node scripts/design-check.mjs --docs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
